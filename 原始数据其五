# ============================================================
# 全量验证：使用 zeros6 全部数据（约 200 万个零点）
# 目标：检验素数频率信号是否随数据量增加而增强
# ============================================================

import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import lombscargle
from scipy.stats import gaussian_kde
import urllib.request
import os
import time

# 1. 下载或读取 zeros6 文件（如果已有则跳过下载）
url = "https://www-users.cse.umn.edu/~odlyzko/zeta_tables/zeros6"
filename = "zeros6.txt"

if not os.path.exists(filename):
    print(f"⏳ 正在下载 {filename} (约 35MB)，请耐心等待...")
    urllib.request.urlretrieve(url, filename)
    print("✅ 下载完成。")

print("⏳ 正在读取全部零点数据...")
start_time = time.time()
zeros = []
with open(filename, "r") as f:
    for line in f:
        line = line.strip()
        if line:
            try:
                zeros.append(float(line))
            except ValueError:
                continue
        # 每 50 万行打印一次进度
        if len(zeros) % 500000 == 0 and len(zeros) > 0:
            print(f"  已读取 {len(zeros)} 个零点...")
print(f"✅ 成功加载 {len(zeros)} 个零点 (耗时 {time.time()-start_time:.1f} 秒)")

# 2. 计算归一化间距
print("⏳ 计算间距并归一化...")
spacings = np.diff(zeros)
avg_spacing = np.mean(spacings)
norm_spacings = spacings / avg_spacing
print(f"✅ 归一化完成，平均间距 = {avg_spacing:.6f}")

# 3. 构造残差序列 (KDE 方法)
print("⏳ 构造残差序列...")
r_grid = np.linspace(0, 8, 500)
kde = gaussian_kde(norm_spacings, bw_method=0.1)
kde_values = kde(r_grid)

def gue_pdf(r):
    return (np.pi * r / 2) * (1 - (np.pi * r / 4)**2) * np.exp(-np.pi * r**2 / 16)

residual = kde_values - gue_pdf(r_grid)
print("✅ 残差序列构造完成")

# 4. 对多个素数频率进行检验
prime_list = [2, 3, 5, 7, 11, 13, 17, 19]
n_permutations = 200  # 为保证速度，设200次；如果希望更严谨，可增至1000次
print(f"\n⏳ 开始对 {len(prime_list)} 个素数频率进行置换检验 (每次 {n_permutations} 次置换)...")

results = {}
for p in prime_list:
    f_theory = np.log(p) / (2 * np.pi)
    angular_freq = 2 * np.pi * f_theory
    
    # 真实功率
    power_obs = lombscargle(r_grid, residual, [angular_freq])
    power_obs = float(power_obs[0]) if np.ndim(power_obs) > 0 else float(power_obs)
    
    # 置换检验
    powers_null = np.zeros(n_permutations)
    for i in range(n_permutations):
        shuffled = np.random.permutation(residual)
        pwr = lombscargle(r_grid, shuffled, [angular_freq])
        powers_null[i] = float(pwr[0]) if np.ndim(pwr) > 0 else float(pwr)
    
    p_value = np.sum(powers_null >= power_obs) / n_permutations
    results[p] = {'freq': f_theory, 'power': power_obs, 'p_value': p_value}
    print(f"  素数 {p}: 频率={f_theory:.6f}, p值={p_value:.4f}")

# 5. Bonferroni 校正
alpha = 0.05
n_tests = len(prime_list)
bonferroni_alpha = alpha / n_tests
print("\n" + "=" * 60)
print("📊 多重比较校正 (Bonferroni) 结果")
print("=" * 60)
print(f"显著性水平 α = {alpha}, 检验次数 = {n_tests}")
print(f"Bonferroni 校正后阈值 = {bonferroni_alpha:.6f}")

significant = []
for p, res in results.items():
    is_sig = res['p_value'] < bonferroni_alpha
    status = "✅ 显著" if is_sig else "❌ 不显著"
    print(f"  素数 {p}: p值 = {res['p_value']:.4f} -> {status}")
    if is_sig:
        significant.append(p)

# 6. 最终结论
print("\n" + "=" * 60)
print("🎯 最终结论 (使用 200 万个零点)")
print("=" * 60)
if significant:
    print(f"✅ 在 Bonferroni 校正后，以下素数频率仍然显著: {significant}")
    print("   信号强度随数据量增加而增强，验证了理论方向。")
else:
    print("❌ 在 Bonferroni 校正后，没有素数频率达到显著性标准。")
    print("   可能需要更大规模的数据集 (如 10^9 级)。")

# 7. 额外：对比之前 20 万的结果
print("\n📌 对比提醒：之前 20 万个零点中，素数 2,3,5 显著。")
print("   现在 200 万个零点中，显著集合为:", significant if significant else "暂无")
print("   若显著素数增多或 p 值下降，说明信号确实随样本量收敛。")
