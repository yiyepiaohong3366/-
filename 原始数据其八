# 1. 定义所有相关频率：单素数、双素数组合、素数平方
freqs_all = []
labels_all = []

# 单素数
for p in [2, 3, 5, 7]:
    f = np.log(p) / (2 * np.pi)
    freqs_all.append(f)
    labels_all.append(f'log{p}')

# 双素数组合 (a*b)
combs = [(2,3), (2,5), (2,7), (3,5), (3,7), (5,7)]
for a, b in combs:
    f = np.log(a * b) / (2 * np.pi)
    freqs_all.append(f)
    labels_all.append(f'log{a*b}')

# 素数平方 (p^2)
for p in [2, 3, 5]:
    f = np.log(p**2) / (2 * np.pi)
    freqs_all.append(f)
    labels_all.append(f'log{p^2}')

